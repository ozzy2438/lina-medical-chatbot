# Provide either AI_GATEWAY_API_KEY (Vercel AI Gateway) or OPENAI_API_KEY.
# Without a key, Lina runs the deterministic fallback pipeline (safety + intent + RAG-BM25).
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=

# Optional overrides
LINA_MODEL=openai/gpt-4o-mini
LINA_EMBEDDING_MODEL=openai/text-embedding-3-small
LINA_TEMPERATURE=0.2
LINA_TOP_K=5
LINA_LOCALE=en-US
LINA_EMERGENCY_NUMBER=your local emergency number
